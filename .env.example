# Server-only Copilot Studio / Direct Line secret. Never prefix this with NEXT_PUBLIC_.
DIRECT_LINE_SECRET=
# Usually leave this unchanged. Override only for a documented regional Direct Line endpoint.
DIRECT_LINE_BASE_URL=https://directline.botframework.com
# Optional comma-separated origins used when generating Direct Line tokens.
DIRECT_LINE_TRUSTED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Optional client request timeout. Default is 180000 (3 minutes).
NEXT_PUBLIC_DIRECT_LINE_TIMEOUT_MS=180000
