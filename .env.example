# Public production URL used to resolve canonical and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://ask-revantage.vercel.app

# Recommended: paste the token endpoint shown in Copilot Studio under
# Channels > Mobile app. Keep this value server-side.
COPILOT_STUDIO_TOKEN_ENDPOINT=

# Alternative for a Direct Line enabled agent. Never expose this in NEXT_PUBLIC_*.
COPILOT_STUDIO_DIRECT_LINE_SECRET=

# Optional region override. The global Direct Line endpoint is used by default.
COPILOT_STUDIO_DIRECT_LINE_BASE_URL=https://directline.botframework.com

# Optional production data-source management service. When omitted, the admin
# data-source configuration is stored only in the current browser workspace.
DATA_SOURCE_API_URL=
DATA_SOURCE_STORE=
