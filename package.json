{
  "name": "ask-revantage",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:routes": "node scripts/clean-obsolete-routes.mjs",
    "predev": "npm run clean:routes",
    "dev": "next dev",
    "pretypecheck": "npm run clean:routes",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run clean:routes",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
